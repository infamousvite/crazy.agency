---
/**
 * "Chi c'è dietro": Marco e Giorgia, che rispondono e costruiscono i siti.
 * La foto si mette in site.team.photo; finché manca, il monogramma G&M.
 */
import { t, type Lang } from '../i18n';
import { site, whatsappLabel } from '../data/site';
import Icon from './Icon.astro';
interface Props { lang: Lang; heading?: 'h2' | 'h3' }
const { lang, heading = 'h2' } = Astro.props;
const H = heading;
const L = <T,>(v: { it: T; en: T }) => t(lang, v);
const [a, b] = site.team.names;
const names = { it: `${a} e ${b}`, en: `${a} and ${b}` };
const [m1, m2] = site.team.monogram.split('&');
const wa = site.whatsapp;
const waText = encodeURIComponent(L({ it: `Ciao ${names.it}, vorremmo informazioni per un sito.`, en: `Hi ${names.en}, we'd like some information about a website.` }));
---
<section class="person" aria-labelledby="person-title">
  <div class="wrap person__inner">
    <figure class="person__photo" data-reveal>
      {site.team.photo
        ? <img src={site.team.photo} alt={L({ it: `${names.it}, chi costruisce i siti di Crazy.`, en: `${names.en}, who build Crazy.'s websites` })} width="800" height="1000" loading="lazy" />
        : <span class="person__mono" aria-hidden="true">{m1}<span class="person__amp">&amp;</span>{m2}</span>}
    </figure>
    <div class="person__text">
      <H id="person-title" class="person__title" data-reveal>{L({ it: `Piacere, ${names.it}.`, en: `Nice to meet you: ${names.en}.` })}</H>
      <p class="lead" data-reveal>{L({
        it: `Disegniamo e costruiamo insieme ogni sito di Crazy., dalla prima chiacchierata alla messa online, qui a Thiene. Niente centralini e niente passaggi di mano: se hai una domanda, ti rispondiamo noi.`,
        en: `Together we design and build every Crazy. website, from the first chat to launch, here in Thiene. No call centre, no hand-offs: if you have a question, we answer.`,
      })}</p>
      {wa && (
        <div class="person__actions" data-reveal>
          <a class="btn" href={`https://wa.me/${wa}?text=${waText}`} target="_blank" rel="noopener">
            <span>{L({ it: 'Scrivici su WhatsApp', en: 'Message us on WhatsApp' })}</span>
            <span class="btn__icon"><Icon name="whatsapp-logo" /></span>
          </a>
          <span class="person__num tnum">{whatsappLabel(wa)}</span>
        </div>
      )}
      <p class="person__place"><Icon name="map-pin" /> {L({ it: 'Thiene (VI). Incontri di persona in zona, a distanza ovunque.', en: 'Thiene, Italy. In person nearby, remotely anywhere.' })}</p>
    </div>
  </div>
</section>
<style>
  .person { padding-block: clamp(4.5rem, 9vw, 7rem); }
  .person__inner { display: grid; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .person__photo { margin: 0; aspect-ratio: 4 / 5; max-width: 26rem; border-radius: var(--r-lg); overflow: hidden; background: var(--panel); box-shadow: inset 0 0 0 1px var(--line), var(--shadow); }
  .person__photo img { width: 100%; height: 100%; object-fit: cover; }
  .person__mono { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; font-family: var(--font-display); font-weight: 700; font-size: clamp(4.6rem, 11vw, 7.4rem); letter-spacing: -0.05em; color: var(--on-violet); background: var(--violet); }
  .person__amp { font-weight: 400; opacity: .5; margin-inline: .04em; }
  .person__title { font-size: var(--fs-h2); max-width: 15ch; }
  .person .lead { margin-top: 1.4rem; max-width: 44ch; }
  .person__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 2rem; }
  .person__num { color: var(--ink-2); font-weight: 550; }
  .person__place { display: flex; align-items: center; gap: .5rem; margin-top: 1.6rem; color: var(--muted); font-size: .95rem; }
  .person__place :global(svg) { width: 1.1rem; height: 1.1rem; color: var(--violet-ink); }
  @media (min-width: 860px) { .person__inner { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); } }
</style>
