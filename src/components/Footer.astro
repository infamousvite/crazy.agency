---
import { url, ui, t, type Lang } from '../i18n';
import { site } from '../data/site';
import Logo from './Logo.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <p class="footer__logo"><button type="button" class="footer__play" data-logo-play aria-label={t(lang, { it: 'Crazy.: fai girare il punto', en: 'Crazy.: spin the dot' })}><Logo playable label="" /></button></p>
      <p class="muted">{t(lang, ui.footer.claim)}</p>
      <p class="muted">{t(lang, ui.footer.based)}</p>
    </div>
    <div class="footer__col">
      <a class="footer__big" href={url(lang, 'contact')}>{t(lang, ui.nav.cta)}</a>
      {site.emailConfirmed && <a href={`mailto:${site.email}`}>{site.email}</a>}
      {site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`}>WhatsApp</a>}
      {site.social.instagram && <a href={site.social.instagram} rel="noopener" target="_blank">Instagram</a>}
    </div>
    <nav class="footer__col" aria-label={t(lang, ui.footer.sections)}>
      <a href={url(lang, 'work')}>{t(lang, ui.nav.work)}</a>
      <a href={url(lang, 'services')}>{t(lang, ui.nav.services)}</a>
      <a href={url(lang, 'concept')}>{lang === 'it' ? 'Laboratorio' : 'Lab'}</a>
      <a href={url(lang, 'about')}>{t(lang, ui.nav.about)}</a>
    </nav>
  </div>
  <div class="wrap footer__legal">
    <span>© {year} {site.legalName}{site.vat && `. ${site.vat}`}</span>
    <span class="footer__legal-links">
      <a href={url(lang, 'privacy')}>{t(lang, ui.footer.legal)}</a>
      <a href={url(lang, 'cookies')}>{t(lang, ui.footer.cookies)}</a>
    </span>
  </div>
</footer>

<style>
  .footer { position: relative; background: var(--bg-2); padding-top: clamp(4rem, 8vw, 6rem); box-shadow: inset 0 1px 0 var(--line); }
  .footer__inner { display: grid; gap: 2.5rem; padding-bottom: 3.5rem; }
  .footer__logo { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.6rem, 7vw, 4.4rem); letter-spacing: -0.045em; line-height: 1; margin-bottom: 1.2rem; }
  .footer__play { display: block; padding: 0; border: 0; background: none; color: inherit; font: inherit; cursor: pointer; border-radius: 8px; -webkit-tap-highlight-color: transparent; }
  .footer__play:focus-visible { outline: 2px solid var(--violet-ink); outline-offset: 6px; }
  .footer__brand .muted { max-width: 40ch; }
  .footer__brand .muted + .muted { margin-top: .4rem; }
  .footer__col { display: grid; gap: .1rem; align-content: start; }
  .footer__col a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--ink-2); text-decoration: none; width: fit-content; transition: color 200ms ease; }
  .footer__big { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; letter-spacing: -0.02em; color: var(--ink) !important; margin-bottom: .4rem; }
  @media (hover: hover) and (pointer: fine) { .footer a:hover { color: var(--violet-ink) !important; } }
  .footer__legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-block: 1.4rem; font-size: .85rem; color: var(--muted); box-shadow: inset 0 1px 0 var(--line); }
  .footer__legal-links { display: flex; gap: 1.2rem; }
  .footer__legal-links a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .footer__legal a { text-decoration: none; }
  @media (min-width: 860px) { .footer__inner { grid-template-columns: 1.7fr 1fr 1fr; } }
</style>
