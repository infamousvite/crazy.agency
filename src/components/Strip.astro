---
/**
 * Fila di schede concept: al passaggio del mouse (o al focus) la scheda
 * si allarga e il video parte, le vicine si stringono. Su telefono: griglia.
 */
import { ui, t, type Lang } from '../i18n';
import type { Concept } from '../data/concepts';
import Icon from './Icon.astro';
interface Props { lang: Lang; items: Concept[]; lead?: boolean; notes?: boolean }
const { lang, items, lead = false, notes = false } = Astro.props;
---
<ul class:list={['strip', lead && 'strip--lead']}>
  {items.map((c) => (
    <li class="strip__card" data-hover-host tabindex={c.url ? undefined : 0} aria-label={c.url ? undefined : `${c.name}, ${c.kind[lang]} (${t(lang, ui.common.concept)})`}>
      <img src={`/media/concept/${c.slug}.webp`} alt="" width="960" height="600" loading="lazy" />
      <video muted loop playsinline preload="none" data-hover-play data-src={`/media/concept/${c.slug}.mp4`}></video>
      <div class="strip__cap" aria-hidden={c.url ? undefined : 'true'}>
        <b>{c.name}</b>
        <span class="strip__kind">{t(lang, ui.common.concept)} · {c.kind[lang]}</span>
        {notes && <span class="strip__note">{c.note[lang]}</span>}
        {c.url && <span class="strip__open">{t(lang, { it: 'Apri il sito', en: 'Open the site' })} <Icon name="arrow-up-right" /></span>}
      </div>
      {c.url && <a class="strip__link" href={c.url} target="_blank" rel="noopener"><span class="sr-only">{`${c.name}, ${c.kind[lang]} (${t(lang, ui.common.concept)}): ${t(lang, { it: 'apri il sito in una nuova scheda', en: 'open the site in a new tab' })}`}</span></a>}
    </li>
  ))}
</ul>
<style>
  .strip { display: grid; gap: .75rem; }
  .strip__card { position: relative; overflow: hidden; border-radius: var(--r-lg); aspect-ratio: 16 / 10; background: var(--panel); box-shadow: inset 0 0 0 1px var(--line); cursor: pointer; outline-offset: 4px; }
  .strip__card img, .strip__card video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .strip__card video { opacity: 0; transition: opacity 350ms ease; }
  .strip__card video:global(.is-playing) { opacity: 1; }
  .strip__card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(22 19 31 / 0.94) 0%, rgb(22 19 31 / 0.82) 26%, rgb(22 19 31 / 0.2) 55%, transparent 72%); pointer-events: none; }
  .strip__cap { position: absolute; left: 1rem; right: 1rem; bottom: 1rem; z-index: 1; display: grid; gap: .25rem; justify-items: start; color: #fff; }
  .strip__cap b { font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; letter-spacing: -0.03em; margin-top: .4rem; white-space: nowrap; }
  .strip__kind { color: rgb(255 255 255 / 0.82); font-size: .88rem; white-space: nowrap; }
  @media (max-width: 899.98px) { .strip__cap { left: .6rem; right: .6rem; bottom: .6rem; padding: .7rem .85rem; border-radius: 12px; background: rgb(22 19 31 / 0.86); backdrop-filter: blur(6px); } }
  @media (max-width: 899.98px) { .strip__cap { grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: .75rem; padding: .6rem .7rem .6rem .85rem; } .strip__cap b { grid-column: 1 / -1; margin-top: 0; } .strip__kind { min-width: 0; overflow: hidden; text-overflow: ellipsis; } .strip__open { margin-top: 0; padding: .3rem .7rem; } }
  .strip__note { color: rgb(255 255 255 / 0.85); font-size: .9rem; max-width: 40ch; }
  .strip__open { display: inline-flex; align-items: center; gap: .35rem; margin-top: .5rem; padding: .35rem .8rem; border-radius: 999px; background: rgb(255 255 255 / 0.2); backdrop-filter: blur(6px); font-size: .85rem; font-weight: 550; color: #fff; }
  .strip__open :global(svg) { width: .95em; height: .95em; }
  .strip__link { position: absolute; inset: 0; z-index: 2; border-radius: inherit; }
  .strip__link:focus-visible { outline: 2px solid var(--violet-ink); outline-offset: 4px; }
  .strip__card:has(.strip__link:focus-visible) { flex-grow: 3.6; }
  @media (min-width: 900px) {
    .strip { display: flex; height: clamp(22rem, 32vw, 30rem); }
    .strip__card { flex: 1 1 0; aspect-ratio: auto; min-width: 0; transition: flex-grow 640ms var(--ease-drawer); }
    .strip--lead .strip__card:first-child { flex-grow: 2.6; }
    .strip:has(.strip__card:hover, .strip__card:focus-visible, .strip__link:focus-visible) .strip__card { flex-grow: 1; }
    .strip:has(.strip__card:hover, .strip__card:focus-visible, .strip__link:focus-visible) .strip__card:is(:hover, :focus-visible, :has(.strip__link:focus-visible)) { flex-grow: 3.6; }
    .strip__cap > :not(b) { opacity: 0; transition: opacity 260ms ease; }
    .strip__note { max-height: 0; overflow: hidden; }
    .strip__card:hover .strip__cap > *, .strip__card:focus-visible .strip__cap > *, .strip__card:has(.strip__link:focus-visible) .strip__cap > * { opacity: 1; transition-delay: 180ms; }
    .strip__card:hover .strip__note, .strip__card:focus-visible .strip__note { max-height: 4.5em; }
    .strip--lead:not(:has(.strip__card:hover, .strip__card:focus-visible)) .strip__card:first-child .strip__cap > * { opacity: 1; }
    .strip__cap b { transition: transform 400ms var(--ease-out); }
  }
</style>
